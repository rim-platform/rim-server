# TLS for one server; certificates come from Let's Encrypt for RIM_DOMAIN, and for RIM_WEB_DOMAIN
# when it is set. Without RIM_WEB_DOMAIN the web client and the API share RIM_DOMAIN's origin.
# With it the web client is served on RIM_WEB_DOMAIN and calls the API on that origin, while
# RIM_DOMAIN stays the server's name for the discovery document and other servers.
{$RIM_DOMAIN} {$RIM_WEB_DOMAIN} {
	# Attachments are up to 25 MiB and forwarded requests up to 32 MiB.
	request_body {
		max_size 32MiB
	}

	# The probes stay on the compose network; the client's fallback page must not answer them.
	@probes path /healthz /readyz
	handle @probes {
		respond 404
	}

	# The web domain, the one host here besides RIM_DOMAIN: the API and the discovery document the
	# client reads go to rim-server, the rest to the web client. Other servers reach RIM_DOMAIN
	# only.
	@web_domain not host {$RIM_DOMAIN}
	handle @web_domain {
		@client path /api /api/* /.well-known/rim-server
		handle @client {
			reverse_proxy rim:8080 {
				header_up -Forwarded
			}
		}

		handle {
			reverse_proxy web:80 {
				header_up -Forwarded
			}
		}
	}

	# Signed server-to-server bodies pass unchanged: no compression, no rewriting.
	@rim path /api /api/* /s2s/* /.well-known/*
	handle @rim {
		reverse_proxy rim:8080 {
			header_up -Forwarded
		}
	}

	# With a web domain, a browser that opens RIM_DOMAIN, such as an invite link built on
	# RIM_PUBLIC_BASE_URL, goes there with the path and query kept.
	handle {
		@web_elsewhere expression `"{$RIM_WEB_DOMAIN}" != ""`
		redir @web_elsewhere https://{$RIM_WEB_DOMAIN}{uri}

		reverse_proxy web:80 {
			header_up -Forwarded
		}
	}

	# While rim-server or the web client cannot be reached, as during an upgrade's restart, a
	# client is told the server is being updated instead of seeing a bare 502. API and
	# server-to-server callers get JSON they can retry; browsers get a page that reloads itself.
	handle_errors 502 503 504 {
		header Retry-After 30
		header Cache-Control no-store

		@machine path /api /api/* /s2s/* /.well-known/*
		handle @machine {
			header Content-Type application/json
			respond `{"error":"unavailable","message":"The server is being updated. Try again in a minute."}` 503
		}

		handle {
			header Content-Type "text/html; charset=utf-8"
			respond <<HTML
				<!doctype html>
				<html lang="en">
				<head>
				<meta charset="utf-8">
				<meta name="viewport" content="width=device-width, initial-scale=1">
				<meta http-equiv="refresh" content="30">
				<title>RIM is being updated</title>
				<style>
				body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0b0d12; color: #e6e8ee; font: 16px/1.5 system-ui, sans-serif; }
				main { max-width: 28rem; padding: 2rem; text-align: center; }
				h1 { font-size: 1.25rem; margin: 0 0 .5rem; }
				p { margin: 0; color: #9aa1b1; }
				</style>
				</head>
				<body>
				<main>
				<h1>RIM is being updated</h1>
				<p>The server is unavailable for a minute or two while it is updated. This page reloads on its own.</p>
				</main>
				</body>
				</html>
				HTML 503
		}
	}
}
