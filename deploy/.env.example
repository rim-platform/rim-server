# Settings for deploy/compose.yml (and deploy/compose.relay.yml, compose.monitoring.yml and
# compose.monitoring-containers.yml on top of it).
# Copy to deploy/.env, fill in, and keep it private: `chmod 600 deploy/.env`.
# Git ignores deploy/.env. A line left commented out keeps the default named next to it.

# --- Required -------------------------------------------------------------------------------

# Password of the `rim` database user. Generate one:
#   openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# The domain this server answers at. DNS A/AAAA records point at this host; Caddy gets the
# certificate from Let's Encrypt for it on the first request.
RIM_DOMAIN=rim.example.org

# --- Images ---------------------------------------------------------------------------------

# The release both published images run: ghcr.io/rim-platform/rim-server:<RIM_VERSION> and
# ghcr.io/rim-platform/rim-web:<RIM_VERSION>. Commented out it is `latest`, which moves with
# every release; set the version, such as 0.0.1, so an upgrade happens only when you change it.
# Keep the checkout of this repository at the same tag, v<RIM_VERSION>.
# RIM_VERSION=0.0.1

# Other images in place of the published ones, for the `migrate` and `rim` services and for
# the web client. With deploy/compose.dev.yml the defaults are rim-server:local and
# rim-web:local, built from local checkouts.
# RIM_SERVER_IMAGE=
# RIM_WEB_IMAGE=

# GraphQL endpoint baked into the web client when deploy/compose.dev.yml builds it. `/api` is
# the page's own origin, so the image works on any domain, like the published one.
# `https://<RIM_DOMAIN>/api` works too and ties the image to that domain.
# RIM_WEB_GRAPHQL_ENDPOINT=/api

# --- Server ---------------------------------------------------------------------------------

# The https origin clients and other servers reach this server at. Commented out it is
# https://<RIM_DOMAIN>. Set but empty, server-to-server traffic is off and
# RIM_KEY_LOGIN_AUDIENCES must name where clients reach the server.
# RIM_PUBLIC_BASE_URL=https://rim.example.org

# A second domain that serves the web client with deploy/Caddyfile, lowercase and other than
# RIM_DOMAIN; its DNS records point at this host too. The client calls the API on that domain,
# RIM_DOMAIN stays the server's name for apps and other servers, and a browser that opens
# RIM_DOMAIN is redirected there. Commented out, the web client is served on RIM_DOMAIN.
# RIM_WEB_DOMAIN=chat.example.org

# One more origin the server accepts browser requests from, besides its own. The web client on
# https://<RIM_DOMAIN> needs nothing; commented out it is https://<RIM_WEB_DOMAIN> when that is
# set, and setting it replaces that origin.
# RIM_CORS_ALLOWED_ORIGIN=https://app.example.org

# The host[:port] values a key login may name as its audience, comma-separated. Commented out
# it is the host of RIM_PUBLIC_BASE_URL, and RIM_DOMAIN and RIM_WEB_DOMAIN when RIM_WEB_DOMAIN is
# set; set, it replaces them, so list the domains too.
# RIM_KEY_LOGIN_AUDIENCES=

# The domain of people's handles here: @<username>:<domain>. Commented out it is the host of
# RIM_PUBLIC_BASE_URL. Another domain, such as the apex of the server's own subdomain, must
# serve {"delegate": "<RIM_PUBLIC_BASE_URL's origin>"} at https://<domain>/.well-known/rim-server,
# or other servers show no handles for people here (docs/server-identity.md).
# RIM_HANDLE_DOMAIN=

# Log filter.
# RUST_LOG=info

# Signups. The default is invite-only: `rim-server invite create` prints signup links.
# `true` lets anyone sign up, rate-limited per
# address. A proof-of-work of that many leading zero bits (1-40) admits signups without an
# invite and wins over open registration; the relay defaults to 24.
# RIM_OPEN_REGISTRATION=false
# RIM_REGISTRATION_POW_BITS=

# New accounts sign up with a key only, and every password signup is refused (default: true).
# false accepts password signups again. Existing password accounts sign in either way.
# RIM_SIGNUP_REQUIRE_KEYS=true

# The id of a workspace on this server that every new account joins as a member, with its
# public channels, whichever way it signs up. Commented out, a new account joins only the
# workspace its invite names. A workspace that does not exist here stops the server at boot.
# RIM_DEFAULT_WORKSPACE=

# Or describe the default workspace in a file instead: its name, DM policy and channels
# (deploy/default-workspace.json, mounted at /config/default-workspace.json). While nobody has
# claimed it, every start writes a single-use owner claim link to /data/owner-claim.txt; the
# account that signs up through it creates the workspace and owns it, and later starts apply
# the file again (new channels, topics, the name). Needs invite-only or proof-of-work signups
# until claimed. Set together with RIM_DEFAULT_WORKSPACE, or with an invalid file, the server
# stops at boot. A relay that hosts a workspace sets it (deploy/README.md).
# RIM_DEFAULT_WORKSPACE_FILE=/config/default-workspace.json

# Serve the GraphiQL explorer at GET /api when true (default: false).
# RIM_ENABLE_GRAPHIQL=

# Seconds between digest runs, at least 60 (default: 900).
# RIM_NOTIFICATION_DIGEST_INTERVAL_SECS=

# Server ids refused on every server-to-server endpoint, comma-separated.
# RIM_S2S_DENIED_PEERS=

# Server ids allowed on host endpoints, comma-separated (default: any).
# RIM_HOST_ALLOWED_RELAYS=

# Who outside a shared workspace may start a DM with people here: open, requests (default:
# their first message is a request), partners (only people on the RIM_DM_PARTNERS servers and
# this one) or none. With partners or none other servers get no identity of anyone here.
# RIM_DM_INBOUND=
# Whom on other servers people here may start a DM with: allowed (default), partners or none.
# RIM_DM_OUTBOUND=
# Server ids the partners settings name, comma-separated.
# RIM_DM_PARTNERS=

# Server-to-server requests per peer per minute (default: 600).
# RIM_S2S_PEER_RATE_PER_MIN=

# Delegations one relay may hold on this host (default: 10000).
# RIM_S2S_SUBSCRIPTIONS_PER_PEER=

# Hours every delivery to a relay may fail before nothing new is queued for it (default: 24).
# RIM_S2S_PEER_DEAD_AFTER_HOURS=

# Largest server-to-server request body (default: 8388608).
# RIM_S2S_MAX_BODY_BYTES=

# Allow server-to-server traffic over http when true; development only.
# RIM_S2S_ALLOW_HTTP=

# Allow peers on private addresses when true; development only.
# RIM_S2S_ALLOW_PRIVATE_ADDRESSES=

# Mail for password resets, invites and notification digests. Without RIM_SMTP_HOST and
# RIM_SMTP_FROM mail is only logged.
# RIM_SMTP_HOST=smtp.example.org
# RIM_SMTP_PORT=587
# RIM_SMTP_USERNAME=
# RIM_SMTP_PASSWORD=
# RIM_SMTP_FROM=RIM <noreply@example.org>
# RIM_SMTP_TLS=starttls

# A short text the clients show people on this server, at most 500 characters, such as who runs
# it and how to reach them.
# RIM_INSTANCE_NOTICE=

# The terms of service, an absolute http(s) URL, for terms hosted elsewhere. Set, every signup
# must accept these terms and the server records the acceptance on the account.
# RIM_TERMS_URL=https://rim.example.org/terms

# The terms of service as a Markdown file this server serves at /api/terms; that page is then
# the terms every signup accepts. compose.yml mounts deploy/terms.md at /config/terms.md:
# rewrite it for your server first, since it is the public RIM server's. A missing, empty or
# oversized file, or a FILL: placeholder left in it, stops the server at boot, and so does
# setting RIM_TERMS_URL too.
# RIM_TERMS_FILE=/config/terms.md

# Where to report abuse on this server: an email address or an https URL. Published in the
# server's signed descriptor and shown by clients.
# RIM_ABUSE_CONTACT=abuse@rim.example.org

# The age, 13 to 21, every signup confirms the person has reached. Self-declared: nothing
# checks it, and the account records only the age it confirmed.
# RIM_MINIMUM_AGE=16

# Days between an account's deletion request and its purge, 0 to 30 (default 14). Until then the
# person can cancel; 0 purges at the next hourly run.
# RIM_ACCOUNT_DELETION_GRACE_DAYS=14

# Usernames and display names nobody may sign up with or change to, compared ignoring case and
# Unicode compatibility forms; `rim` also reserves rim-…, rim_…, rim.… and "rim …". Put your
# maintainers' names here once their accounts exist.
# RIM_RESERVED_NAMES=rim,admin,moderator,support

# Link preview fetches the server runs at once, 1 to 64 (default 8). A fetch that waits longer
# than five seconds for a free slot is dropped and the link gets no preview.
# RIM_LINK_PREVIEW_CONCURRENCY=8

# Argon2 password hashes and checks (signups, password logins, resets) run at once, 1 to 64
# (default: the number of CPUs). Each holds 64 MiB while it runs; a request that waits over 10
# seconds for a turn answers UNAVAILABLE.
# RIM_PASSWORD_HASH_CONCURRENCY=

# Days command audit rows are kept, 1 to 3650; older ones are exported to /data/audit-exports
# and deleted daily. Commented out, rows are kept forever.
# RIM_AUDIT_RETENTION_DAYS=90

# Optional features switched off, comma-separated: attachments, link_previews, email,
# custom_emoji, workspace_plugins, ai_commands. An unknown name stops the server at boot;
# docs/operations/features.md says what each one covers and what clients see.
# RIM_FEATURES_DISABLED=attachments,custom_emoji

# The Prometheus metrics listener (RIM_METRICS_ADDR) stays commented out in compose.yml's `rim`
# service; deploy/compose.monitoring.yml turns it on, on the internal network only.

# --- Request limits -------------------------------------------------------------------------

# What one client may send; each is off when unset or 0. docs/api.md ("Limits") says what a
# client sees past each one. Requests one client address sends to /api routes per minute, with
# a burst of the same size.
# RIM_RATE_REQUESTS_PER_MIN_PER_IP=
# Mutation fields one session runs per minute; signed-out callers count per address.
# RIM_RATE_MUTATIONS_PER_MIN_PER_SESSION=
# Messages one user sends per minute, and how many at once (default: the per-minute number).
# RIM_RATE_MESSAGES_PER_MIN_PER_USER=
# RIM_RATE_MESSAGES_BURST=
# WebSocket connections one user holds open, and subscriptions one connection holds.
# RIM_RATE_WS_CONNECTIONS_PER_USER=
# RIM_RATE_SUBSCRIPTIONS_PER_CONNECTION=
# Seconds between rechecks of the sessions open WebSocket connections run under, so a session
# ended in another server process or from the command line closes them (default: 30, 0 = off).
# RIM_WS_SESSION_RECHECK_SECS=
# GraphQL requests in one batch (default: 20).
# RIM_API_MAX_BATCH=

# --- Instance limits ------------------------------------------------------------------------

# How much of each thing the instance holds; each is off when unset or 0, and past one a write
# answers VALIDATION naming the cap. Clients read them from serverInfo.limits. The values below
# suit a small public test instance. Devices and DM requests also follow the relay quotas
# below; the stricter number applies. Message bytes go up to 65536.
# RIM_LIMIT_WORKSPACES_PER_USER=5
# RIM_LIMIT_MEMBERS_PER_WORKSPACE=50
# RIM_LIMIT_CHANNELS_PER_WORKSPACE=30
# RIM_LIMIT_DEVICES_PER_USER=5
# RIM_LIMIT_DM_REQUESTS_PER_DAY=20
# RIM_LIMIT_MACROS_PER_WORKSPACE=50
# RIM_LIMIT_PIPELINES_PER_WORKSPACE=50
# RIM_LIMIT_PLUGINS_PER_WORKSPACE=50
# RIM_LIMIT_INVITE_MAX_USES=5
# RIM_LIMIT_MESSAGE_BYTES=8192
# Unlike the caps above these two are on by default, at 50; 0 turns either off.
# Workspace invites one user creates, and invite emails one user sends, per 24 hours.
# RIM_LIMIT_INVITES_PER_USER_PER_DAY=50
# Pending invitations to encrypted conversations one user holds.
# RIM_LIMIT_PENDING_INVITES_PER_USER=50
# Local accounts the instance holds, those waiting out their deletion grace period included.
# At the cap every signup, with an operator's invite too, answers REGISTRATION_FULL and
# serverInfo.registrationFull and the discovery document say the server is full.
# RIM_LIMIT_ACCOUNTS=1000

# Probation of new accounts: for this many hours after its creation an account creates no
# workspace and sends no DM request to a stranger, and sends messages at the probation rate
# (per minute, with a burst of the same size) instead of the normal one. Off when unset or 0.
# RIM_PROBATION_HOURS=24
# RIM_RATE_PROBATION_MESSAGES_PER_MIN=5

# --- Ports ----------------------------------------------------------------------------------

# Host ports Caddy publishes. Let's Encrypt needs 80 and 443 reachable from the internet.
# RIM_HTTP_PORT=80
# RIM_HTTPS_PORT=443

# --- Relay (compose.relay.yml only) ---------------------------------------------------------

# The first two are required with compose.relay.yml, which stops every compose command and names
# the one that is missing. The server's role: relay (accounts and their traffic, no workspaces)
# or both (workspaces too).
# RIM_ROLE=both
# Caddy's configuration: ./Caddyfile.relay serves the API alone, ./Caddyfile the web client too.
# RIM_CADDYFILE=./Caddyfile
# web starts the web client that ./Caddyfile serves; left out with ./Caddyfile.relay.
# COMPOSE_PROFILES=web

# Per-user quotas of a public relay; docs/operations/relay-public.md says what each one limits.
# RIM_RELAY_QUEUE_BYTES_PER_USER=67108864
# RIM_RELAY_CARD_MAX_BYTES=131072
# RIM_RELAY_KEY_PACKAGES_PER_DEVICE=100
# RIM_RELAY_DEVICES_PER_USER=32
# RIM_S2S_DEVICE_RATE_PER_MIN=120
# RIM_RELAY_FORWARDS_PER_USER_PER_DAY=50000
# RIM_RELAY_DM_REQUESTS_PER_DAY=20
# RIM_RELAY_RETENTION_DAYS=30

# --- Monitoring (compose.monitoring.yml, compose.monitoring-containers.yml) -----------------

# Where deploy/compose.monitoring.yml sends the metrics; with the overlay, every compose command
# stops and names the one that is missing. The overlay also turns on rim-server's metrics
# listener (RIM_METRICS_ADDR=0.0.0.0:9090), on the internal network only. In the Grafana Cloud
# portal, the stack's Prometheus "Details" page shows the remote-write URL and the instance ID
# (the user). The token is an access policy token with the `metrics:write` scope only.
# GRAFANA_CLOUD_METRICS_URL=https://prometheus-prod-<n>-<region>.grafana.net/api/prom/push
# GRAFANA_CLOUD_METRICS_USER=
# GRAFANA_CLOUD_METRICS_TOKEN=

# The group of /var/run/docker.sock, for compose.monitoring-containers.yml's socket proxy:
#   stat -c %g /var/run/docker.sock
# DOCKER_GID=

# --- Backups (deploy/backup.sh, restore.sh, restore-drill.sh) -------------------------------

# Where backups are written; relative paths are from the directory the script runs in.
# RIM_BACKUP_DIR=./backups

# An age recipient (age1…) or a file of recipients: with it each backup is encrypted and no
# unencrypted copy stays on disk.
# RIM_BACKUP_AGE_RECIPIENT=

# The age identity file that decrypts backups, for restore.sh and restore-drill.sh.
# RIM_BACKUP_AGE_IDENTITY=

# --- Upgrades (deploy/upgrade.sh, deploy/rim-deploy.sh) -------------------------------------

# The compose files the scripts and `docker compose` use, relative to the directory they run
# from; unset, the scripts use deploy/compose.yml. A relay whose files sit in one directory,
# as rim-deploy installs them: compose.yml:compose.relay.yml
# COMPOSE_FILE=

# How long upgrade.sh waits, in seconds, for /readyz and then for the public discovery
# document before it rolls back.
# RIM_UPGRADE_TIMEOUT=90
