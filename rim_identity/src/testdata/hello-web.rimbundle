{"format":"rim-plugin-bundle","v":1,"files":[{"path":"main.mjs","text":"const port = globalThis.rimPluginPort;\nconst ID = \"dev.example.hello-web\";\nconst send = (m) => port.postMessage(JSON.stringify({ jsonrpc: \"2.0\", ...m }));\nlet who = null;\nport.onmessage = (event) => {\n  let m;\n  try { m = JSON.parse(event.data); } catch { return; }\n  const p = m.params ?? {};\n  switch (m.method) {\n    case \"rim.handshake\": {\n      const ok = p.supportedVersions?.includes(1) && p.pluginId === ID;\n      who = p.principal;\n      send({ id: m.id, result: { accepted: ok, protocolVersion: 1, pluginId: ID } });\n      break;\n    }\n    case \"rim.heartbeat\":\n      send({ id: m.id, result: {} });\n      break;\n    case \"rim.principal.changed\":\n      who = p.principal;\n      break;\n    case \"rim.command.execute\":\n      if (p.commandId === \"greet\") send({ id: m.id, result: { payload: `Hello, ${who?.displayName ?? \"world\"}!` } });\n      else send({ id: m.id, error: { code: -32602, message: `unknown command: ${p.commandId}` } });\n      break;\n    default:\n      if (m.id != null && m.method) send({ id: m.id, error: { code: -32601, message: `method not found: ${m.method}` } });\n  }\n};\n"},{"path":"rim-plugin.json","text":"{\"manifest_version\":1,\"plugin_id\":\"dev.example.hello-web\",\"display_name\":\"Hello Web\",\"version\":\"0.1.0\",\"description\":\"Says hello from a sandboxed frame.\",\"runtime_kind\":\"WebSandboxed\",\"entrypoint\":\"main.mjs\",\"commands\":[{\"id\":\"greet\",\"title\":\"Hello Web: Greet\",\"description\":\"Greets the signed-in user.\"}]}"}]}